#!/bin/bash

# kubectl plugin for Failure Analysis Tool
# Usage: kubectl fat <bundle.tgz> [options]

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Default values
NAMESPACE=${KUBECTL_PLUGINS_LOCAL_FLAG_NAMESPACE:-failure-analysis-tool}
BUNDLE_PATH=""
OUTPUT_DIR="/tmp/fat-analysis"
PVC_NAME="fat-analysis-storage"
POD_NAME="fat-analyzer"
IMAGE="PLACEHOLDER_ECR_REGISTRY/failure-analysis-tool/app:latest"

print_status() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

show_help() {
    cat << EOF
kubectl fat - Failure Analysis Tool Plugin

Usage:
  kubectl fat <bundle.tgz> [options]

Options:
  -n, --namespace <namespace>    Kubernetes namespace (default: failure-analysis-tool)
  -o, --output <path>           Output path for results (default: ./fat-output)
  --pvc <name>                  PVC name for storage (default: fat-analysis-storage)
  --image <image>               Container image to use (default: from deployment)
  -h, --help                    Show this help message

Examples:
  kubectl fat bundle.tgz
  kubectl fat bundle.tgz -n my-namespace -o ./results
  kubectl fat bundle.tgz --pvc my-storage

EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -n|--namespace)
            NAMESPACE="$2"
            shift 2
            ;;
        -o|--output)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        --pvc)
            PVC_NAME="$2"
            shift 2
            ;;
        --image)
            IMAGE="$2"
            shift 2
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        -*)
            print_error "Unknown option: $1"
            show_help
            exit 1
            ;;
        *)
            if [ -z "$BUNDLE_PATH" ]; then
                BUNDLE_PATH="$1"
            else
                print_error "Multiple bundle paths specified"
                show_help
                exit 1
            fi
            shift
            ;;
    esac
done

# Validate bundle path
if [ -z "$BUNDLE_PATH" ]; then
    print_error "Bundle path is required"
    show_help
    exit 1
fi

if [ ! -f "$BUNDLE_PATH" ]; then
    print_error "Bundle file not found: $BUNDLE_PATH"
    exit 1
fi

if [[ ! "$BUNDLE_PATH" =~ \.(tgz|tar\.gz)$ ]]; then
    print_error "Bundle must be a .tgz or .tar.gz file"
    exit 1
fi

# Check prerequisites
if ! command -v kubectl &> /dev/null; then
    print_error "kubectl is not installed or not in PATH"
    exit 1
fi

# Check namespace exists
if ! kubectl get namespace "$NAMESPACE" &> /dev/null; then
    print_warning "Namespace $NAMESPACE does not exist. Creating..."
    kubectl create namespace "$NAMESPACE"
    print_status "Namespace created"
fi

# Get image from deployment if not specified
if [[ "$IMAGE" == "PLACEHOLDER_ECR_REGISTRY"* ]]; then
    print_info "Detecting image from deployment..."
    DEPLOYMENT_IMAGE=$(kubectl get deployment log-analysis-aiops -n "$NAMESPACE" -o jsonpath='{.spec.template.spec.containers[0].image}' 2>/dev/null || echo "")
    if [ -n "$DEPLOYMENT_IMAGE" ]; then
        IMAGE="$DEPLOYMENT_IMAGE"
        print_status "Using image from deployment: $IMAGE"
    else
        print_error "Could not detect image. Please specify --image"
        exit 1
    fi
fi

BUNDLE_FILENAME=$(basename "$BUNDLE_PATH")
POD_STORAGE_PATH="/data"

print_info "Starting analysis..."
print_info "Bundle: $BUNDLE_PATH"
print_info "Namespace: $NAMESPACE"
print_info "Output: $OUTPUT_DIR"

# Create PVC if it doesn't exist
if ! kubectl get pvc "$PVC_NAME" -n "$NAMESPACE" &> /dev/null; then
    print_info "Creating PVC: $PVC_NAME"
    cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: $PVC_NAME
  namespace: $NAMESPACE
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 10Gi
EOF
    print_status "PVC created"
else
    print_status "PVC already exists"
fi

# Wait for PVC to be bound
print_info "Waiting for PVC to be ready..."
kubectl wait --for=condition=Bound pvc/$PVC_NAME -n "$NAMESPACE" --timeout=60s

# Create pod for analysis
print_info "Creating analysis pod..."
cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: Pod
metadata:
  name: $POD_NAME
  namespace: $NAMESPACE
spec:
  restartPolicy: Never
  containers:
  - name: analyzer
    image: $IMAGE
    command: ["/bin/sh", "-c", "sleep 7200"]
    resources:
      requests:
        memory: "1Gi"
        cpu: "500m"
      limits:
        memory: "4Gi"
        cpu: "2000m"
    volumeMounts:
    - name: storage
      mountPath: $POD_STORAGE_PATH
  volumes:
  - name: storage
    persistentVolumeClaim:
      claimName: $PVC_NAME
EOF

# Wait for pod to be ready
print_info "Waiting for pod to be ready..."
kubectl wait --for=condition=Ready pod/$POD_NAME -n "$NAMESPACE" --timeout=60s

# Copy bundle to pod
print_info "Copying bundle to pod..."
kubectl cp "$BUNDLE_PATH" "$NAMESPACE/$POD_NAME:$POD_STORAGE_PATH/$BUNDLE_FILENAME"

# Run analysis
print_info "Running analysis..."
print_info "This may take several minutes depending on bundle size..."

# Run analysis and stream output
if kubectl exec -n "$NAMESPACE" "$POD_NAME" -- python -m src.cli.main \
    "$POD_STORAGE_PATH/$BUNDLE_FILENAME" \
    -o "$POD_STORAGE_PATH/output" \
    -j "$POD_STORAGE_PATH/analysis_result.json"; then
    print_status "Analysis completed successfully"
else
    print_error "Analysis failed"
    print_info "Checking pod logs..."
    kubectl logs pod/$POD_NAME -n "$NAMESPACE" --tail=50
    kubectl delete pod/$POD_NAME -n "$NAMESPACE" --ignore-not-found=true
    exit 1
fi

# Copy results back
print_info "Copying results back..."
mkdir -p "$OUTPUT_DIR"

# Copy analysis result JSON
if kubectl cp "$NAMESPACE/$POD_NAME:$POD_STORAGE_PATH/analysis_result.json" "$OUTPUT_DIR/analysis_result.json" 2>/dev/null; then
    print_status "Analysis report copied"
else
    print_warning "Could not copy analysis_result.json"
fi

# Copy extracted bundle and output if they exist
if kubectl exec -n "$NAMESPACE" "$POD_NAME" -- test -d "$POD_STORAGE_PATH/output" 2>/dev/null; then
    kubectl cp "$NAMESPACE/$POD_NAME:$POD_STORAGE_PATH/output" "$OUTPUT_DIR/output" 2>/dev/null && \
        print_status "Output directory copied" || print_warning "Could not copy output directory"
fi

# Cleanup pod
print_info "Cleaning up pod..."
kubectl delete pod/$POD_NAME -n "$NAMESPACE" --ignore-not-found=true --wait=false

# Show results
print_status "Analysis complete!"
print_info "Results saved to: $OUTPUT_DIR"
if [ -f "$OUTPUT_DIR/analysis_result.json" ]; then
    print_info "Analysis report: $OUTPUT_DIR/analysis_result.json"
    
    # Show summary
    if command -v jq &> /dev/null; then
        echo ""
        echo "Summary:"
        jq '.summary' "$OUTPUT_DIR/analysis_result.json" 2>/dev/null || echo "Install jq for JSON summary"
    fi
fi

